// Benchmark 3: bubble sort (Statically Provable)
// Bubble sort on array a[500].
int a[500];

int main() {
    int iters = 4;
    int rep = 0;
    int checksum = 0;

    while (rep < iters) {
        int i = 0;
        while (i < 500) {
            a[i] = (500 - i + rep * 17) % 1009;
            i = i + 1;
        }

        i = 0;
        while (i < 499) {
            int j = 0;
            while (j < 499 - i) {
                if (a[j] > a[j + 1]) {
                    int tmp = a[j];
                    a[j] = a[j + 1];
                    a[j + 1] = tmp;
                }
                j = j + 1;
            }
            i = i + 1;
        }

        checksum = (checksum + a[0] * 3 + a[250] * 5 + a[499] * 7) % 1000000007;
        rep = rep + 1;
    }

    print(checksum);
    return 0;
}
