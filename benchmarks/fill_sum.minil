// Benchmark 1: fill_sum (Statically Provable)
// Fills an array and sums it repeatedly.
int a[5000];

int main() {
    int iters = 80;
    int rep = 0;
    int total = 0;

    while (rep < iters) {
        int i = 0;
        while (i < 5000) {
            a[i] = (i * 3 + rep) % 10007;
            i = i + 1;
        }

        i = 0;
        while (i < 5000) {
            total = (total + a[i]) % 1000000007;
            i = i + 1;
        }
        rep = rep + 1;
    }

    print(total);
    return 0;
}
