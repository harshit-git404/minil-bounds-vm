// Jacobi 1D 3-point stencil (statically provable)
int a[40000];
int b[40000];

int main() {
    int n = 40000;
    int t_steps = 10;
    int i = 0;
    int t = 0;

    while (i < 40000) {
        a[i] = (i * 37 + 11) % 1000;
        b[i] = 0;
        i = i + 1;
    }

    while (t < 10) {
        i = 1;
        while (i < 39999) {
            b[i] = (a[i - 1] + a[i] + a[i + 1]) / 3;
            i = i + 1;
        }
        i = 1;
        while (i < 39999) {
            a[i] = (b[i - 1] + b[i] + b[i + 1]) / 3;
            i = i + 1;
        }
        t = t + 1;
    }

    int chk = 0;
    i = 0;
    while (i < 40000) {
        chk = (chk * 19 + a[i]) % 1000000007;
        i = i + 1;
    }
    print(chk);
    return 0;
}
