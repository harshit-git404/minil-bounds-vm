// Benchmark 12: rec_sum (Data-Dependent / Recursion)
// Recursive array sum over array rdata[1000].
int rdata[1000];

int rec_sum_fn(int i, int n) {
    if (i >= n) {
        return 0;
    }
    return rdata[i] + rec_sum_fn(i + 1, n);
}

int main() {
    int i = 0;
    while (i < 1000) {
        rdata[i] = (i * 7 + 1) % 100;
        i = i + 1;
    }

    int iters = 800;
    int rep = 0;
    int total = 0;

    while (rep < iters) {
        total = (total + rec_sum_fn(0, 1000)) % 1000000007;
        rep = rep + 1;
    }

    print(total);
    return 0;
}
