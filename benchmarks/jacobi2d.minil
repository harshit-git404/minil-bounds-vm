// Jacobi 2D 5-point stencil (statically provable)
int a[14400];
int b[14400];

int main() {
    int n = 120;
    int t_steps = 10;
    int i = 0;
    int j = 0;
    int t = 0;
    int idx = 0;

    while (i < 14400) {
        a[i] = (i * 43 + 7) % 1000;
        b[i] = 0;
        i = i + 1;
    }

    while (t < 10) {
        i = 1;
        while (i < 119) {
            j = 1;
            while (j < 119) {
                idx = i * 120 + j;
                b[idx] = (a[idx - 120] + a[idx + 120] + a[idx - 1] + a[idx + 1] + a[idx]) / 5;
                j = j + 1;
            }
            i = i + 1;
        }
        i = 1;
        while (i < 119) {
            j = 1;
            while (j < 119) {
                idx = i * 120 + j;
                a[idx] = (b[idx - 120] + b[idx + 120] + b[idx - 1] + b[idx + 1] + b[idx]) / 5;
                j = j + 1;
            }
            i = i + 1;
        }
        t = t + 1;
    }

    int chk = 0;
    i = 0;
    while (i < 14400) {
        chk = (chk * 23 + a[i]) % 1000000007;
        i = i + 1;
    }
    print(chk);
    return 0;
}
