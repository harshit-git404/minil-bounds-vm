// Benchmark 5: sieve (Statically Provable)
// Sieve of Eratosthenes up to 8000.
int flags[8000];

int main() {
    int iters = 50;
    int rep = 0;
    int prime_count = 0;

    while (rep < iters) {
        int i = 0;
        while (i < 8000) {
            flags[i] = 1;
            i = i + 1;
        }

        flags[0] = 0;
        flags[1] = 0;

        int p = 2;
        while (p * p < 8000) {
            if (flags[p] == 1) {
                int mult = p * p;
                while (mult < 8000) {
                    flags[mult] = 0;
                    mult = mult + p;
                }
            }
            p = p + 1;
        }

        prime_count = 0;
        i = 0;
        while (i < 8000) {
            if (flags[i] == 1) {
                prime_count = prime_count + 1;
            }
            i = i + 1;
        }

        rep = rep + 1;
    }

    print(prime_count);
    return 0;
}
