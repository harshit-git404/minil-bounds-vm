// Merge sort (statically provable / parameter-bounded)
int data[20000];
int temp[20000];

int merge(int l, int m, int r) {
    int i = l;
    int j = m + 1;
    int k = l;
    while (k <= r) {
        temp[k] = data[k];
        k = k + 1;
    }
    k = l;
    while (i <= m) {
        if (j <= r) {
            if (temp[i] <= temp[j]) {
                data[k] = temp[i];
                i = i + 1;
            } else {
                data[k] = temp[j];
                j = j + 1;
            }
        } else {
            data[k] = temp[i];
            i = i + 1;
        }
        k = k + 1;
    }
    while (j <= r) {
        data[k] = temp[j];
        j = j + 1;
        k = k + 1;
    }
    return 0;
}

int msort(int l, int r) {
    if (l < r) {
        int m = (l + r) / 2;
        msort(l, m);
        msort(m + 1, r);
        merge(l, m, r);
    }
    return 0;
}

int main() {
    int n = 15000;
    int seed = 9876543;
    int i = 0;
    while (i < n) {
        seed = (seed * 1103515245 + 12345) % 2147483647;
        if (seed < 0) {
            seed = -seed;
        }
        data[i] = seed % 100000;
        i = i + 1;
    }
    msort(0, n - 1);

    int chk = 0;
    i = 0;
    while (i < n) {
        chk = (chk * 31 + data[i]) % 1000000007;
        i = i + 1;
    }
    print(chk);
    return 0;
}
