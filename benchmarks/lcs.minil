// Longest Common Subsequence dynamic programming (statically provable)
int seq1[700];
int seq2[700];
int dp0[701];
int dp1[701];

int main() {
    int len = 700;
    int i = 0;
    int j = 0;
    int k = 0;
    int m1 = 0;
    int m2 = 0;

    while (i < 700) {
        seq1[i] = (i * 17 + 5) % 26;
        seq2[i] = (i * 23 + 9) % 26;
        i = i + 1;
    }

    while (j <= 700) {
        dp0[j] = 0;
        dp1[j] = 0;
        j = j + 1;
    }

    i = 0;
    while (i < 700) {
        j = 0;
        while (j < 700) {
            if (seq1[i] == seq2[j]) {
                dp1[j + 1] = dp0[j] + 1;
            } else {
                m1 = dp0[j + 1];
                m2 = dp1[j];
                if (m1 > m2) {
                    dp1[j + 1] = m1;
                } else {
                    dp1[j + 1] = m2;
                }
            }
            j = j + 1;
        }
        k = 0;
        while (k <= 700) {
            dp0[k] = dp1[k];
            k = k + 1;
        }
        i = i + 1;
    }

    int chk = dp0[700];
    print(chk);
    return 0;
}
