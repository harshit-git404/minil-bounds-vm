// Bubble sort test
int data[10];

int main() {
    data[0] = 64;
    data[1] = 34;
    data[2] = 25;
    data[3] = 12;
    data[4] = 22;
    data[5] = 11;
    data[6] = 90;
    data[7] = 88;
    data[8] = 45;
    data[9] = 50;

    int n = 10;
    int i = 0;
    while (i < n - 1) {
        int j = 0;
        while (j < n - i - 1) {
            if (data[j] > data[j + 1]) {
                int temp = data[j];
                data[j] = data[j + 1];
                data[j + 1] = temp;
            }
            j = j + 1;
        }
        i = i + 1;
    }

    // Print sorted array
    i = 0;
    while (i < n) {
        print(data[i]);
        i = i + 1;
    }
    return 0;
}
