// Arithmetic and boolean operations test
int main() {
    int a = 10 + 20 * 3;     // 70
    int b = (100 - 40) / 4;  // 15
    int c = 17 % 5;          // 2
    int d = -c;              // -2
    int e = !0;              // 1
    int f = !42;             // 0

    int g = (a > b) && (c != 0); // 1
    int h = (a < b) || (d == -2); // 1
    int k = 100 / -3;        // -33 (truncated toward zero)
    int m = 100 % -3;        // 1

    print(a);
    print(b);
    print(c);
    print(d);
    print(e);
    print(f);
    print(g);
    print(h);
    print(k);
    print(m);
    return 0;
}
