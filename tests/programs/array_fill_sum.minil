// Array fill and sum test
int arr[50];

int main() {
    int i = 0;
    while (i < 50) {
        arr[i] = i * i;
        i = i + 1;
    }

    int total = 0;
    i = 0;
    while (i < 50) {
        total = total + arr[i];
        i = i + 1;
    }

    print(total); // sum of i^2 for i=0..49: 49*50*99/6 = 40425
    return 0;
}
