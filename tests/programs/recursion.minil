// Recursion test: factorial and gcd
int fact(int n) {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

int gcd(int a, int b) {
    if (b == 0) {
        return a;
    }
    return gcd(b, a % b);
}

int main() {
    print(fact(6));       // 720
    print(gcd(48, 18));   // 6
    return 0;
}
